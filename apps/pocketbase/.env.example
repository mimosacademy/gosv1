# PocketBase runtime secrets
PB_ENCRYPTION_KEY=<strong-random-encryption-key>
PB_SUPERUSER_EMAIL=<admin-email>
PB_SUPERUSER_PASSWORD=<strong-random-password>
PB_STAFF_DEFAULT_PASSWORD=<strong-random-password>

# Public URL used when configuring CORS / reverse proxy
PB_PUBLIC_URL=https://pb.example.com
